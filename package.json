{
  "name": "ryadom-student-portal",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1",
    "better-auth": "1.7.20",
    "@better-auth/prisma-adapter": "1.7.20",
    "@node-rs/argon2": "2.2.2",
    "zod": "4.6.7",
    "lucide-react": "1.72.0",
    "@fontsource/inter": "5.3.0",
    "ical.js": "2.2.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "pdf-lib": "1.17.1",
    "@pdf-lib/fontkit": "1.1.1",
    "dotenv": "17.2.3",
    "node-ical": "0.27.6"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "@types/node": "22.19.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/pg": "8.15.6",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.0",
    "prettier": "3.6.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "type": "module"
}
